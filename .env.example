# Run `python3 -m redhawk init` to generate a real random key in .env.
LAB_API_KEY=replace-with-a-random-key-at-least-24-characters
LAB_BASE_URL=http://127.0.0.1:8787
N8N_WEBHOOK_URL=
ZAPIER_WEBHOOK_URL=
MAKE_WEBHOOK_URL=
# Optional separate key for authenticated n8n inbound webhooks; header: X-Lab-Key
N8N_WEBHOOK_KEY=
